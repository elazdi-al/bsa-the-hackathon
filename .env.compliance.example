# Copy these values into your local .env.local. Do not put secrets in NEXT_PUBLIC_*.
COMPLIANCE_MODE=demo
COMPLIANCE_API_KEY=local-demo-only-change-before-deployment
COMPLIANCE_AUDIT_FILE=var/compliance/audit.ndjson

# Live providers: supply all four variables; a policy example is documented in docs/COMPLIANCE.md.
# COMPLIANCE_MODE=live
# COMPLIANCE_POLICY_FILE=policies/live.json
# COMPLIANCE_RPC_URLS={"84532":"https://sepolia.base.org"}
# COMPLIANCE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# TRM_API_KEY=optional-api-key
