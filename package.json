{
  "name": "swissquote-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "local": "node scripts/local.ts",
    "partner": "node --env-file-if-exists=.env.local services/partner/server.ts",
    "e2e": "node --env-file-if-exists=.env.local scripts/e2e.ts",
    "e2e:ui": "node --env-file-if-exists=.env.local scripts/ui-e2e.ts",
    "warp": "node --env-file-if-exists=.env.local scripts/warp.ts",
    "check": "node lib/wallet/shamir.check.ts && node app/onboarding-secure/flow.check.mjs && node 'app/(tabs)/_components/amount.check.mjs'",
    "check:onboarding": "node --env-file-if-exists=.env.local scripts/onboarding.check.mjs",
    "contracts:test": "cd contracts && forge test",
    "test:compliance": "node --import tsx --test tests/compliance/*.test.ts",
    "demo:compliance": "tsx tools/compliance-demo.ts",
    "check:compliance-providers": "tsx tools/compliance-provider-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@noble/curves": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "glimm": "^0.3.1",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "ox": "^0.14.54",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
