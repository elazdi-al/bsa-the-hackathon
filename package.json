    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "4.23.15"
  }
