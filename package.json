{
  "name": "fuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "signer:swissquote": "ROLE=swissquote node --env-file-if-exists=.env.local services/signer/server.ts",
    "signer:partner": "ROLE=partner node --env-file-if-exists=.env.local services/signer/server.ts",
    "contracts:test": "cd contracts && forge test",
