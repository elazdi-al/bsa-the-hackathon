{
  "name": "swissquote-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ios": "CAPACITOR=1 next build && cap sync ios",
    "ios:sim": "NEXT_PUBLIC_SOFTWARE_PASSKEY=1 npm run ios",
    "ios:open": "cap open ios",
    "typecheck": "next typegen && tsc --noEmit",
    "prelocal": "node -e \"process.versions.node.localeCompare('22.18',undefined,{numeric:true})<0&&(console.error('Node 22.18 or later is needed, found '+process.version+'. Get it at https://nodejs.org'),process.exit(1))\"",
    "local": "node scripts/local.ts",
    "status": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts status",
    "fund": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts fund",
    "account": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts account",
    "send": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts send",
    "recover": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts recover",
    "finish": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts finish",
    "cancel": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts cancel",
    "warp": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning scripts/cli.ts warp",
    "partner": "node --env-file-if-exists=.env.local services/partner/server.ts",
    "e2e": "node --env-file-if-exists=.env.local scripts/e2e.ts",
    "e2e:ui": "node --env-file-if-exists=.env.local scripts/ui-e2e.ts",
    "check": "node lib/wallet/shamir.check.ts && node app/onboarding-secure/flow.check.mjs && node 'app/(tabs)/_components/amount.check.mjs'",
    "check:onboarding": "node --env-file-if-exists=.env.local scripts/onboarding.check.mjs",
    "contracts:test": "cd contracts && forge test",
    "test:compliance": "node --import tsx --test tests/compliance/*.test.ts",
    "demo:compliance": "tsx tools/compliance-demo.ts",
    "check:compliance-providers": "tsx tools/compliance-provider-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/core": "~8.5.3",
    "@capacitor/ios": "~8.5.3",
    "@noble/curves": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "glimm": "^0.3.1",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "ox": "^0.14.54",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "vaul": "^1.1.2",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
