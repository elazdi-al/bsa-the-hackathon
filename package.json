    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "glimm": "^0.3.1",
    "input-otp": "^1.5.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "ox": "^0.14.54",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
