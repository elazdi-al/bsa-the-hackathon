# Copy to .env.local. Read by the Wallet API (next dev), both share services and scripts/e2e.ts.

# Chain and bundler. Defaults: Base Sepolia public RPC and Pimlico's public bundler.
RPC_URL=https://sepolia.base.org
BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc

# Swissquote's key: paymaster signer, ticket signer and recovery guardian. Needs a little
# Base Sepolia ETH to deploy, fund the paymaster and send cancel/finalize transactions.
SWISSQUOTE_KEY=
SWISSQUOTE_ADDRESS=

# Printed by: cd contracts && forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $SWISSQUOTE_KEY --broadcast
FACTORY_ADDRESS=
PAYMASTER_ADDRESS=

# Shamir share services: B at Swissquote, C at the independent service.
# At-rest keys are 32 bytes of hex: openssl rand -hex 32
SWISSQUOTE_SHARES_URL=http://localhost:4001
PARTNER_SHARES_URL=http://localhost:4002
SWISSQUOTE_SHARE_KEY=
PARTNER_SHARE_KEY=

SESSION_SECRET=
