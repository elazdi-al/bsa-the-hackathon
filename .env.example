# `npm run local` writes .env.local for a local anvil chain, on the ports in PORT, RPC_PORT and
# PARTNER_PORT. This file is only for Base Sepolia. Copy it to .env.local and fill it in.

CHAIN=base-sepolia
# History reads up to 50,000 blocks of logs at once. Base's own RPC (sepolia.base.org) serves 200.
RPC_URL=https://base-sepolia-rpc.publicnode.com

# Swissquote's key: paymaster signer, ticket signer, recovery guardian and the account that submits
# operations. Needs Base Sepolia ETH to deploy, fund the paymaster and pay for operations.
SWISSQUOTE_KEY=
SWISSQUOTE_ADDRESS=

# Printed by: cd contracts && forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $SWISSQUOTE_KEY --broadcast
# The deploy makes a mintable test USDC. RECOVERY_DELAY (seconds, default 48 hours) sets the recovery hold.
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
USDC_ADDRESS=
FACTORY_ADDRESS=
PAYMASTER_ADDRESS=
VAULT_ADDRESS=

# Keys that seal Share B (Swissquote) and Share C (partner) at rest: openssl rand -hex 32
SWISSQUOTE_SHARE_KEY=
PARTNER_SHARE_KEY=
PARTNER_URL=http://localhost:4002
# The phone posts Share C here directly; pinned at build time so Swissquote cannot redirect it.
NEXT_PUBLIC_PARTNER_URL=http://localhost:4002

# Compliance policy for sponsorship. Demo mode uses fixture screening and simulation. The policy must list the
# deployed USDC and vault for chain 84532; without one, the built-in demo policy points at a placeholder vault.
COMPLIANCE_MODE=demo
COMPLIANCE_POLICY_FILE=
# Live mode needs all of these (see README.md):
# COMPLIANCE_MODE=live
# COMPLIANCE_POLICY_FILE=policies/live.json
# COMPLIANCE_RPC_URLS={"84532":"https://sepolia.base.org"}
# COMPLIANCE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# COMPLIANCE_API_KEY=
# TRM_API_KEY=
